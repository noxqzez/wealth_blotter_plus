# -----------------------------------------------------------------------------
# Wealth Blotter Plus — environment template
# Copy to `.env` and fill locally. NEVER commit real secrets.
# -----------------------------------------------------------------------------

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Phase 1 pilot gate (set true on Render / production)
REQUIRE_BYOK=false
REQUIRE_PILOT_APPROVAL=false

# Public API URL for Excel (local or Render) — not a secret
# PUBLIC_API_BASE_URL=https://YOUR_SERVICE.onrender.com

# Supabase (server-side only for SERVICE_ROLE_KEY)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# JWT secret from Supabase Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# FastAPI / app JWT helpers (optional; primary auth is Supabase Auth JWT)
JWT_SECRET_KEY=change_me_use_long_random_string
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated

# LLM — local Ollama by default.
# Production / Render pilots: each user sends BYOK via Excel
#   X-LLM-API-Key + X-LLM-Provider (openai | anthropic).
# Do NOT put pilot keys on Render. LLM_PROVIDER below is only the local fallback
# when no BYOK header is present (ollama | openai | anthropic).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
USE_CLOUD_LLM=false

# Confidence / HITL
CONFIDENCE_THRESHOLD=0.85

# MVP local demo (Excel without SSO). NEVER true on Render.
DEV_AUTH_BYPASS=true
DEV_ADVISOR_ID=00000000-0000-4000-8000-000000000001

# CORS (Excel task pane + Streamlit). On Render, include your Excel HTTPS origin.
CORS_ORIGINS=https://localhost:3000,http://localhost:8501

# API
API_HOST=0.0.0.0
API_PORT=8000

# RAG POC (research PDFs → classify → Hugging Face embed → pgvector)
RAG_STORAGE_BUCKET=research-documents
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIMS=384
RAG_MAX_UPLOAD_BYTES=20971520
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_CLASSIFY_EXCERPT_CHARS=2000
RAG_AUTO_PROCESS_UPLOAD=true
