# -----------------------------------------------------------------------------
# Wealth Blotter Plus — environment template
# Copy to `.env` and fill locally. NEVER commit real secrets.
# -----------------------------------------------------------------------------

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase (server-side only for SERVICE_ROLE_KEY)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# JWT secret from Supabase Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# FastAPI / app JWT helpers (optional; primary auth is Supabase Auth JWT)
JWT_SECRET_KEY=change_me_use_long_random_string
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated

# LLM — local Ollama by default; cloud optional via flags
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
USE_CLOUD_LLM=false

# Confidence / HITL
CONFIDENCE_THRESHOLD=0.85

# CORS (Excel task pane + Streamlit)
CORS_ORIGINS=https://localhost:3000,http://localhost:8501

# API
API_HOST=0.0.0.0
API_PORT=8000
