# Environment & secrets — never commit real credentials
.env
.env.*
!.env.example
!**/.env.example
# Hosted Excel: prefer Render build env VITE_API_BASE_URL over committing live hosts.
# .env.production in git should stay placeholder-only (see frontend_excel/.env.production).
!frontend_excel/.env.production
.env.local
.env.*.local
# Real pilot sideload manifest (email attachment) — never publish default hosts in git
frontend_excel/manifest.pilot.LIVE.xml
*.pem
*.key
*.p12
*.pfx
.streamlit/secrets.toml
**/credentials.json
**/service-account*.json
**/google-services.json


# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.uv/
uv.lock

# Node / frontend_excel
node_modules/
frontend_excel/dist/
frontend_excel/.vite/
frontend_excel/.certs/
*.local

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Certificates (mkcert / local HTTPS)
*.crt
!frontend_excel/**/*.example.*

# Logs & temp (including local screenshots / scratch)
*.log
tmp/
temp/
.cache/
**/_tmp*
tests/_tmp*

# Past Analogue A/B run captures + Tavily query cache (local eval outputs)
artifacts/past_analogue/**
!artifacts/past_analogue/.gitkeep

# Per-run CrewAI audit dumps (keep workflow READMEs)
backend/app/agents/audits/*/local_audit_*.md
backend/app/agents/audits/*/run_*.md
frontend_excel/*.tsbuildinfo
