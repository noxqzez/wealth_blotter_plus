# Baked into `npm run build` / Render Static Site builds.
# Public-ready: do not commit a live hostname here.
# On Render Static Site → Environment, set:
#   VITE_API_BASE_URL=https://wealth-blotter-plus.onrender.com
# (or your API origin). That overrides this placeholder at build time.
VITE_API_BASE_URL=https://YOUR_API_HOST
